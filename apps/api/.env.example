# Database Configuration
# PostgreSQL connection string for local development
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:ShipFlow@DB#2026@localhost:5432/ship_flow_dev?schema=public"
JWT_SECRET="super_secret"
JWT_REFRESH_SECRET="super_refresh_secret"

# Application Configuration
PORT=9000
NODE_ENV=development
FRONTEND_URL=http://localhost:9001

# Gmail SMTP Configuration
# Use a Google App Password (16 chars), NOT your regular Gmail password
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=ShipFlow
