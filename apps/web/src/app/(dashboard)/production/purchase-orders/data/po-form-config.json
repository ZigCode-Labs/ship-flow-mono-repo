{
  "sections": [
    {
      "id": "po_details",
      "title": "PO Details",
      "icon": "box",
      "fields": [
        {
          "id": "poNumber",
          "name": "poNumber",
          "label": "PO Number",
          "type": "text",
          "placeholder": "PO-00001",
          "required": true,
          "readOnly": true,
          "autoGenerate": true
        },
        {
          "id": "poContext",
          "name": "poContext",
          "label": "PO Context",
          "type": "select",
          "required": true,
          "dataSource": "poContexts",
          "defaultValue": "Domestic Purchase"
        },
        {
          "id": "issueDate",
          "name": "issueDate",
          "label": "Issue Date",
          "type": "date",
          "required": true,
          "defaultToday": true
        },
        {
          "id": "expectedDeliveryDate",
          "name": "expectedDeliveryDate",
          "label": "Expected Delivery Date",
          "type": "date",
          "required": false
        },
        {
          "id": "supplier",
          "name": "supplier",
          "label": "Supplier",
          "type": "select",
          "placeholder": "Select a supplier",
          "required": true,
          "dataSource": "suppliers"
        },
        {
          "id": "supplierGstin",
          "name": "supplierGstin",
          "label": "Supplier GSTIN",
          "type": "text",
          "placeholder": "e.g., 27AABCU9603R1ZM",
          "readOnly": false
        },
        {
          "id": "supplierAddress",
          "name": "supplierAddress",
          "label": "Supplier Address",
          "type": "textarea",
          "placeholder": "Enter supplier address",
          "span": 2
        },
        {
          "id": "deliveryLocation",
          "name": "deliveryLocation",
          "label": "Delivery Location",
          "type": "select",
          "placeholder": "Select location",
          "dataSource": "deliveryLocations"
        },
        {
          "id": "currency",
          "name": "currency",
          "label": "Currency",
          "type": "select",
          "required": true,
          "dataSource": "currencies",
          "defaultValue": "INR"
        },
        {
          "id": "paymentTerms",
          "name": "paymentTerms",
          "label": "Payment Terms",
          "type": "text",
          "placeholder": "e.g., Net 30 days"
        },
        {
          "id": "shipToAddress",
          "name": "shipToAddress",
          "label": "Ship To Address",
          "type": "textarea",
          "placeholder": "Delivery address...",
          "span": 2
        }
      ]
    },
    {
      "id": "notes",
      "title": "Notes",
      "icon": "fileText",
      "fields": [
        {
          "id": "notes",
          "name": "notes",
          "label": "Notes (prints on PO)",
          "type": "textarea",
          "placeholder": "Additional notes...",
          "span": 2
        },
        {
          "id": "internalNotes",
          "name": "internalNotes",
          "label": "Internal Notes",
          "type": "textarea",
          "placeholder": "Internal notes (will not appear on the PO)...",
          "span": 2
        }
      ]
    }
  ],
