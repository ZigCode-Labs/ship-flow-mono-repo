      ]
    },
    {
      "title": "Bank Details",
      "fields": [
        {
          "name": "bankName",
          "label": "Bank Name",
          "type": "text",
          "placeholder": "Enter bank name",
          "required": false
        },
        {
          "name": "accountNumber",
          "label": "Account Number",
          "type": "text",
          "placeholder": "Enter account number",
          "required": false
        },
        {
          "name": "ifscCode",
          "label": "IFSC Code",
          "type": "text",
          "placeholder": "Enter IFSC code",
          "required": false
        },
        {
          "name": "branch",
          "label": "Branch",
          "type": "text",
          "placeholder": "Enter branch name",
          "required": false
        }
      ]
    },
    {
      "title": "Terms & Notes",
      "fields": [
        {
          "name": "paymentTerms",
          "label": "Payment Terms",
          "type": "text",
          "placeholder": "Net 30 days",
          "required": false
        },
        {
          "name": "reference",
          "label": "Reference",
          "type": "text",
          "placeholder": "PO number",
          "required": false
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea",
          "placeholder": "Additional notes for the customer...",
          "required": false
        }
      ]
    }
  ]
