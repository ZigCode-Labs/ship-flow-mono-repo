{
  "sections": [
    {
      "id": "invoice_details",
      "title": "Invoice Details",
      "icon": "invoice",
      "layout": "grid-3",
      "fields": [
        {
          "id": "invoice_number",
          "label": "Invoice Number",
          "type": "text",
          "placeholder": "DI-26-27-001",
          "required": true,
          "autoGenerate": true
        },
        {
          "id": "invoice_date",
          "label": "Invoice Date",
          "type": "date",
          "required": true,
          "defaultToday": true
        },
        {
          "id": "due_date",
          "label": "Due Date",
          "type": "date",
          "required": false
        }
      ]
    },
    {
      "id": "exchange_rate",
      "title": "USD to INR Exchange Rate",
      "icon": "refresh",
      "layout": "inline",
      "fields": [
        {
          "id": "usd_inr_rate",
          "label": "1 USD =",
          "type": "number",
          "suffix": "INR",
          "readOnly": false,
          "defaultValue": 93.06
        },
        {
          "id": "live_rate_toggle",
          "label": "Live",
          "type": "toggle",
          "defaultValue": true
        }
      ],
      "note": "Item catalog prices are stored in USD. When you add items, they will be converted to INR using this rate.",
      "actions": [
        {
          "id": "refresh_rate",
          "label": "Refresh",
          "icon": "refresh",
          "type": "button",
          "apiSource": "frankfurter"
        }
      ]
    },
    {
      "id": "seller_details",
      "title": "Seller Details",
      "icon": "invoice",
      "layout": "grid-3",
      "fields": [
        {
          "id": "company_name",
          "label": "Company Name",
          "type": "text",
          "readOnly": true,
          "sourceFrom": "sellerProfile.companyName"
        },
        {
          "id": "gstin",
          "label": "GSTIN",
          "type": "text",
          "readOnly": true,
          "sourceFrom": "sellerProfile.gstin"
        },
        {
          "id": "state",
          "label": "State",
          "type": "text",
          "readOnly": true,
          "sourceFrom": "sellerProfile.state"
        }
      ]
    },
    {
      "id": "customer_details",
      "title": "Customer Details",
      "layout": "grid-1",
      "fields": [
        {
          "id": "select_customer",
          "label": "Select Customer",
          "type": "select",
          "placeholder": "Select a domestic buyer",
          "dataSource": "domesticBuyers",
          "required": true
        },
        {
          "id": "customer_name",
          "label": "Customer Name",
          "type": "text",
          "placeholder": "",
          "autoFillFrom": "select_customer.name"
        },
        {
          "id": "customer_gstin",
          "label": "Customer GSTIN",
          "type": "text",
          "placeholder": "e.g., 27AABC U9608R1ZM",
          "autoFillFrom": "select_customer.gstin"
        },
        {
          "id": "place_of_supply",
          "label": "Place of Supply",
          "type": "select",
          "placeholder": "Select state",
          "dataSource": "indianStates"
        }
      ]
    },
    {
      "id": "bank_details",
      "title": "Bank Details",
      "icon": "bank",
      "layout": "grid-4",
      "fields": [
        {
          "id": "bank_name",
          "label": "Bank Name",
          "type": "text",
          "placeholder": ""
        },
        {
          "id": "account_number",
          "label": "Account Number",
          "type": "text",
          "placeholder": ""
        },
        {
          "id": "ifsc_code",
          "label": "IFSC Code",
          "type": "text",
          "placeholder": ""
        },
        {
          "id": "branch",
          "label": "Branch",
          "type": "text",
          "placeholder": ""
        }
      ]
    },
    {
      "id": "line_items",
      "title": "Line Items",
      "layout": "table",
      "columns": [
        { "id": "item_code", "label": "Item Code" },
        { "id": "description", "label": "Description" },
        { "id": "hsn", "label": "HSN" },
        { "id": "qty", "label": "Qty", "type": "number" },
        { "id": "rate", "label": "Rate (₹)", "type": "number" },
        { "id": "amount", "label": "Amount", "computed": true },
        { "id": "gst", "label": "GST", "type": "select", "dataSource": "gstRates" },
        { "id": "total", "label": "Total", "computed": true }
      ],
      "actions": [
        {
          "id": "add_item",
          "label": "Add Item",
          "icon": "plus",
          "type": "button"
        }
      ],
      "emptyState": "No items added. Click \"Add Item\" to add line items, or select from your Item Register."
    },
    {
      "id": "totals",
      "title": "",
      "layout": "totals",
      "fields": [
        { "id": "subtotal", "label": "Subtotal:", "computed": true },
        {
          "id": "discount",
          "label": "Discount:",
          "type": "number",
          "suffix": "₹",
          "defaultValue": 0
        },
        { "id": "taxable_amount", "label": "Taxable Amount:", "computed": true },
        { "id": "igst", "label": "IGST:", "computed": true },
        { "id": "total_tax", "label": "Total Tax:", "computed": true },
        { "id": "grand_total", "label": "Grand Total:", "computed": true, "highlight": true }
      ]
    },
    {
      "id": "terms_notes",
      "title": "Terms & Notes",
      "layout": "grid-2",
      "fields": [
        {
          "id": "payment_terms",
          "label": "Payment Terms",
          "type": "text",
          "placeholder": "e.g., Net 30 days"
        },
        {
          "id": "reference",
          "label": "Reference",
          "type": "text",
          "placeholder": "e.g., PO number"
        },
        {
          "id": "notes",
          "label": "Notes",
          "type": "textarea",
          "placeholder": "Additional notes for the customer...",
          "fullWidth": true
        }
      ]
    }
  ],
