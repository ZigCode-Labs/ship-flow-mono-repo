{
  "extends": "../../packages/typescript-config/nextjs.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shipflow/shared": ["../../packages/shared/src/index.ts"],
      "@shipflow/ui": ["../../packages/ui/src/index.ts"],
      "@shipflow/ui-forms": ["../../packages/ui-forms/src/index.ts"],
      "@shipflow/ui-table": ["../../packages/ui-table/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
