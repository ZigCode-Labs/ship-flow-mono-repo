# ─── Database (packages/database) ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ship_flow_dev"

# ─── API (apps/api) ────────────────────────────────────────────────────────────
# Port the NestJS server listens on
PORT=6000

# Environment
NODE_ENV=development

# JWT secrets — use long random strings in production
# openssl rand -base64 64
JWT_SECRET="change_me_in_production"
JWT_REFRESH_SECRET="change_me_refresh_in_production"

# ─── Web (apps/web) ────────────────────────────────────────────────────────────
# Public URL of the API as seen from the browser
NEXT_PUBLIC_API_URL="http://localhost:6000"
